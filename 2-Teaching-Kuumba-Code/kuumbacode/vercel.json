{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "Template",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/pricing",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/pricing.html",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/give",
      "destination": "/support",
      "permanent": true
    },
    {
      "source": "/give.html",
      "destination": "/support",
      "permanent": true
    }
  ]
}
