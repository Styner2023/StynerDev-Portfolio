# Copy to .env and fill in your own values. Never commit real keys.

# API (backend)
VITE_API_BASE_URL=

# DFINITY / Internet Computer storage
VITE_USE_DFINITY_STORAGE=true
VITE_DFINITY_CANISTER_ID=
VITE_DFINITY_HOST=

# Auth0
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=

# Build
VITE_NO_CSS_LINT=true

# Feature flags
VITE_USE_PRODUCTION_API=false
